# ============================================================
# REGINSA QA Framework — Variables de Entorno
# Copia como .env y completa los valores.
# NO subas credenciales ni tokens reales al repositorio.
# ============================================================

# ── Entorno base ─────────────────────────────────────────────
REGINSA_URL=https://reginsaqa.sunedu.gob.pe
REGINSA_API_URL=https://reginsaapiqa.sunedu.gob.pe/api
BASE_URL=https://reginsaqa.sunedu.gob.pe
REGINSA_ENVIRONMENT=qa

# ── Playwright (funcional) ───────────────────────────────────
REGINSA_HEADLESS=1
REGINSA_WORKERS=4
REGINSA_PW_RETRIES=1
REGINSA_SCALE_MODE=0
REGINSA_STRICT_VERIFY=1
REGINSA_TARGET_REGISTROS=10
# Evidencia: on-first-retry | on | off | retain-on-failure
REGINSA_TRACE=on-first-retry
REGINSA_SCREENSHOT=only-on-failure
REGINSA_VIDEO=retain-on-failure
# Reporters: full (allure+html+junit+json) | minimal (line+json)
REGINSA_REPORTER_MODE=full

# ── Pool de credenciales Punku SSO (slots 1..8) ─────────────
REGINSA_USER_1=
REGINSA_PASS_1=
REGINSA_USER_2=
REGINSA_PASS_2=
REGINSA_USER_3=
REGINSA_PASS_3=
REGINSA_USER_4=
REGINSA_PASS_4=
REGINSA_USER_5=
REGINSA_PASS_5=
REGINSA_USER_6=
REGINSA_PASS_6=
REGINSA_USER_7=
REGINSA_PASS_7=
REGINSA_USER_8=
REGINSA_PASS_8=
# JSON alternativo: [{"usuario":"u","contrasena":"p"}, ...]
REGINSA_CREDENTIALS_JSON=

# ── k6 Performance ──────────────────────────────────────────
K6_VUS=5
K6_ITERATIONS=
K6_DURATION=1m
K6_AUTH_HEADER=
# HTTP detail mode: all (cada API individual) | guardar_only
K6_HTTP_DETAIL_MODE=all

# ── Grafana Cloud (free tier) ────────────────────────────────
K6_CLOUD_TOKEN=
K6_CLOUD_PROJECT_ID=

# ── SonarQube (Docker local) ────────────────────────────────
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=
SONAR_LOGIN=admin
SONAR_PASSWORD=admin

# ── Azure DevOps (sync bugs SonarQube) ──────────────────────
AZDO_ORG=
AZDO_PROJECT=
AZDO_TOKEN=

# ── Docker (seguridad) ──────────────────────────────────────
# NVD API Key para OWASP Dependency-Check (opcional, mejora velocidad)
NVD_API_KEY=

# ── IP Pool k6 (multi-IP load testing) ──────────────────────
# Dejar vacio para deteccion automatica; o comma-separated IPs
K6_LOCAL_IPS=
