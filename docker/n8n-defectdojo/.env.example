# Copia este archivo como .env en esta misma carpeta y reemplaza los valores.
# No subas el .env real al repositorio.

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<generar-password-local>

DOJO_POSTGRES_PASSWORD=<generar-password-postgres>
DOJO_SUPERUSER_NAME=admin
DOJO_PASSWORD=<generar-password-defectdojo>
DOJO_SUPERUSER_EMAIL=qa@example.local

DD_SECRET_KEY=<generar-secret-key-largo>
DD_CREDENTIAL_AES_256_KEY=<generar-clave-32-bytes>
