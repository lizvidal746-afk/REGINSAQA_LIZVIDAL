{
  "info": {
    "name": "REGINSA API Test - Caso 04 Reconsiderar Con Sanciones",
    "_postman_id": "04fcb56b-c813-4b73-a932-0ef68b2de74a",
    "description": "Objetivo: validar flujo Caso 04 de reconsideracion con sanciones | Reglas: detalle existente, actualizacion valida y confirmacion posterior | Exito: actualizar y confirmar con respuestas funcionales | Evidencia: assertions Postman y XML Newman del caso",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "detalle_id", "value": "" }
  ],
  "item": [
    {
      "name": "1) Auth/Login",
      "description": "Objetivo: autenticar para Caso 04 | Reglas: login valido debe entregar token utilizable | Exito: status 200/201 y token no vacio | Evidencia: test Token presente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": {
          "raw": "{{base_api}}/Auth/Login",
          "host": ["{{base_api}}"],
          "path": ["Auth", "Login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login status 200/201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const data = pm.response.json();",
              "const candidates = [data?.token, data?.accessToken, data?.access_token, data?.oData?.token, data?.oData?.accessToken, data?.oData?.access_token, data?.oData?.jwt];",
              "const token = candidates.find((v) => typeof v === 'string' && v.trim().length > 0) || '';",
              "pm.test('Token presente', function () { pm.expect(token).to.not.equal(''); });",
              "pm.environment.set('token', token);",
              "pm.environment.set('auth_header', token.startsWith('Bearer ') ? token : `Bearer ${token}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "2) DetalleInfraccionSancion/Listar",
      "description": "Objetivo: obtener detalle con sanciones a actualizar | Reglas: listado debe traer al menos un detalle elegible | Exito: status 200 y detalle_id detectado | Evidencia: variable detalle_id seteada",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nPageNumber\": 1,\n  \"nPageSize\": 20,\n  \"conSanciones\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/Listar",
          "host": ["{{base_api}}"],
          "path": ["DetalleInfraccionSancion", "Listar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const raw = body?.oData;",
              "let rows = [];",
              "if (Array.isArray(raw)) rows = raw;",
              "else if (Array.isArray(raw?.Results)) rows = raw.Results;",
              "else if (raw && typeof raw === 'object') rows = [raw];",
              "pm.test('Listado con datos', function () { pm.expect(rows.length).to.be.above(0); });",
              "const first = rows[0] || {};",
              "const id = first.idDetalleInfraccionSancion || first.IdDetalleInfraccionSancion || first.idDetalle;",
              "pm.test('detalle_id detectado', function () { pm.expect(id).to.exist; });",
              "pm.collectionVariables.set('detalle_id', String(id));"
            ]
          }
        }
      ]
    },
    {
      "name": "3) DetalleInfraccionSancion/ActualizarReconsideracion",
      "description": "Objetivo: marcar detalle en reconsideracion | Reglas: idDetalleInfraccionSancion existente y cambio de bitReconsidera permitido | Exito: status 200/201 y bSuccess distinto de false | Evidencia: assertion bSuccess no falso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idDetalleInfraccionSancion\": {{detalle_id}},\n  \"bitReconsidera\": 1,\n  \"fechaReconsideracion\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/ActualizarReconsideracion",
          "host": ["{{base_api}}"],
          "path": ["DetalleInfraccionSancion", "ActualizarReconsideracion"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 o 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.test('bSuccess no falso', function () { pm.expect(body?.bSuccess).to.not.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4) DetalleInfraccionSancion/Confirmar",
      "description": "Objetivo: confirmar detalle ya reconsiderado | Reglas: confirmacion sobre detalle valido previamente actualizado | Exito: status 200/201 y bSuccess distinto de false | Evidencia: assertion bSuccess no falso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idDetalleInfraccionSancion\": {{detalle_id}},\n  \"confirmar\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/Confirmar",
          "host": ["{{base_api}}"],
          "path": ["DetalleInfraccionSancion", "Confirmar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 o 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.test('bSuccess no falso', function () { pm.expect(body?.bSuccess).to.not.eql(false); });"
            ]
          }
        }
      ]
    }
  ]
}
