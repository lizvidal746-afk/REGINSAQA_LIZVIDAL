{
  "info": {
    "name": "REGINSA API Test - Caso 03 Reconsiderar Sin Sanciones",
    "_postman_id": "f4fb5f16-7c32-44de-808c-71e45e18f7b3",
    "description": "Objetivo: validar flujo Caso 03 de reconsideracion sin sanciones | Reglas: cabecera elegible y registro consistente de reconsideracion | Exito: guardar y listar detalle con respuesta funcional | Evidencia: assertions Postman y XML Newman del caso",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "cabecera_id", "value": "" }
  ],
  "item": [
    {
      "name": "1) Auth/Login",
      "description": "Objetivo: autenticar para Caso 03 | Reglas: credenciales activas deben generar token valido | Exito: status 200/201 y token presente | Evidencia: test Login status y auth_header",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": {
          "raw": "{{base_api}}/Auth/Login",
          "host": ["{{base_api}}"],
          "path": ["Auth", "Login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login status 200/201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const data = pm.response.json();",
              "const candidates = [data?.token, data?.accessToken, data?.access_token, data?.oData?.token, data?.oData?.accessToken, data?.oData?.access_token, data?.oData?.jwt];",
              "const token = candidates.find((v) => typeof v === 'string' && v.trim().length > 0) || '';",
              "pm.test('Token presente', function () { pm.expect(token).to.not.equal(''); });",
              "pm.environment.set('token', token);",
              "pm.environment.set('auth_header', token.startsWith('Bearer ') ? token : `Bearer ${token}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "2) CabeceraInfraccionSancion/Listar",
      "description": "Objetivo: obtener cabeceras elegibles sin sanciones | Reglas: debe existir al menos una cabecera pendiente con filtros aplicados | Exito: status 200 y cabecera_id detectado | Evidencia: variable cabecera_id seteada",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nPageNumber\": 1,\n  \"nPageSize\": 20,\n  \"sinSanciones\": true,\n  \"reconsideracionPendiente\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/CabeceraInfraccionSancion/Listar",
          "host": ["{{base_api}}"],
          "path": ["CabeceraInfraccionSancion", "Listar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const raw = body?.oData;",
              "let rows = [];",
              "if (Array.isArray(raw)) rows = raw;",
              "else if (Array.isArray(raw?.Results)) rows = raw.Results;",
              "else if (raw && typeof raw === 'object') rows = [raw];",
              "pm.test('Listado con datos', function () { pm.expect(rows.length).to.be.above(0); });",
              "const first = rows[0] || {};",
              "const id = first.idCabeceraInfraccionSancion || first.IdCabeceraInfraccionSancion || first.idCabecera;",
              "pm.test('cabecera_id detectado', function () { pm.expect(id).to.exist; });",
              "pm.collectionVariables.set('cabecera_id', String(id));"
            ]
          }
        }
      ]
    },
    {
      "name": "3) Reconsideracion/GuardarCabecera",
      "description": "Objetivo: registrar cabecera de reconsideracion | Reglas: idCabeceraInfraccionSancion valido y numero/fecha consistentes | Exito: status 200/201 y bSuccess distinto de false | Evidencia: assertion bSuccess no falso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCabeceraInfraccionSancion\": {{cabecera_id}},\n  \"numeroReconsideracion\": \"POSTMAN-REC-{{ $timestamp }}\",\n  \"fechaReconsideracion\": \"{{$isoTimestamp}}\",\n  \"sinSanciones\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/Reconsideracion/GuardarCabecera",
          "host": ["{{base_api}}"],
          "path": ["Reconsideracion", "GuardarCabecera"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 o 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.test('bSuccess no falso', function () { pm.expect(body?.bSuccess).to.not.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4) DetalleInfraccionSancion/Listar",
      "description": "Objetivo: verificar detalle posterior a reconsideracion sin sanciones | Reglas: backend debe responder consistentemente para la cabecera procesada | Exito: status 200 y respuesta JSON controlada | Evidencia: assertion Respuesta controlada",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "{{auth_header}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nPageNumber\": 1,\n  \"nPageSize\": 20,\n  \"idCabeceraInfraccionSancion\": {{cabecera_id}},\n  \"sinSanciones\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/Listar",
          "host": ["{{base_api}}"],
          "path": ["DetalleInfraccionSancion", "Listar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Respuesta controlada', function () { pm.expect(body).to.be.an('object'); });"
            ]
          }
        }
      ]
    }
  ]
}
