    {
      "name": "2) CabeceraInfraccionSancion/ListarPaginado",
      "description": "Objetivo: obtener cabeceras elegibles sin sanciones | Reglas: debe existir al menos una cabecera pendiente con filtros aplicados | Exito: status 200 y cabecera_id detectado | Evidencia: variable cabecera_id seteada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{auth_header}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nPageNumber\": 1,\n  \"nPageSize\": 20,\n  \"sinSanciones\": true,\n  \"reconsideracionPendiente\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/CabeceraInfraccionSancion/ListarPaginado",
          "host": [
            "{{base_api}}"
          ],
          "path": [
            "CabeceraInfraccionSancion",
            "ListarPaginado"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const raw = body?.oData;",
              "let rows = [];",
              "if (Array.isArray(raw)) rows = raw;",
              "else if (Array.isArray(raw?.Results)) rows = raw.Results;",
              "else if (raw && typeof raw === 'object') rows = [raw];",
              "pm.test('Listado con datos', function () { pm.expect(rows.length).to.be.above(0); });",
              "const first = rows[0] || {};",
              "const id = first.idCabeceraInfraccionSancion || first.IdCabeceraInfraccionSancion || first.idCabecera;",
              "pm.test('cabecera_id detectado', function () { pm.expect(id).to.exist; });",
              "pm.collectionVariables.set('cabecera_id', String(id));"
            ]
          }
        }
      ]
    },
    {
      "name": "3) Reconsideracion/GuardarCabecera",
      "description": "Objetivo: registrar cabecera de reconsideracion | Reglas: idCabeceraInfraccionSancion valido y numero/fecha consistentes | Exito: status 200/201 y bSuccess distinto de false | Evidencia: assertion bSuccess no falso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{auth_header}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idCabeceraInfraccionSancion\": {{cabecera_id}},\n  \"numeroReconsideracion\": \"POSTMAN-REC-{{ $timestamp }}\",\n  \"fechaReconsideracion\": \"{{$isoTimestamp}}\",\n  \"sinSanciones\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/Reconsideracion/GuardarCabecera",
          "host": [
            "{{base_api}}"
          ],
          "path": [
            "Reconsideracion",
            "GuardarCabecera"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 o 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.test('bSuccess no falso', function () { pm.expect(body?.bSuccess).to.not.eql(false); });"
            ]
          }
        }
      ]
    },
