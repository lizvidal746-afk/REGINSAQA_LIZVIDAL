            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{auth_header}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nPageNumber\": 1,\n  \"nPageSize\": 20,\n  \"conSanciones\": true\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/ListarPaginado",
          "host": [
