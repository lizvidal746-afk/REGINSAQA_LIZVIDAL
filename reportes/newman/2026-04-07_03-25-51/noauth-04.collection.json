          ],
          "path": [
            "DetalleInfraccionSancion",
            "ListarPaginado"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "const raw = body?.oData;",
              "let rows = [];",
              "if (Array.isArray(raw)) rows = raw;",
              "else if (Array.isArray(raw?.Results)) rows = raw.Results;",
              "else if (raw && typeof raw === 'object') rows = [raw];",
              "pm.test('Listado con datos', function () { pm.expect(rows.length).to.be.above(0); });",
              "const first = rows[0] || {};",
              "const id = first.idDetalleInfraccionSancion || first.IdDetalleInfraccionSancion || first.idDetalle;",
              "pm.test('detalle_id detectado', function () { pm.expect(id).to.exist; });",
              "pm.collectionVariables.set('detalle_id', String(id));"
            ]
          }
        }
      ]
    },
    {
