          "raw": "{\n  \"idDetalleInfraccionSancion\": {{detalle_id}},\n  \"bitReconsidera\": 1,\n  \"fechaReconsideracion\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{base_api}}/DetalleInfraccionSancion/ActualizarReconsideracion",
          "host": [
            "{{base_api}}"
          ],
          "path": [
            "DetalleInfraccionSancion",
            "ActualizarReconsideracion"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 o 201', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "const body = pm.response.json();",
              "pm.test('bSuccess no falso', function () { pm.expect(body?.bSuccess).to.not.eql(false); });"
            ]
          }
        }
