{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddonResultSchema",
  "type": "object",
  "properties": {
    "addonName": {
      "type": "string"
    },
    "executionTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "properties": {
        "totalTests": { "type": "number" },
        "passed": { "type": "number" },
        "failed": { "type": "number" },
        "skipped": { "type": "number" },
        "score": { "type": "number" }
      },
      "required": ["totalTests", "passed", "failed"]
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "warn"] },
          "description": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "required": ["id", "title", "status"]
      }
    }
  },
  "required": ["addonName", "executionTimestamp", "summary", "details"]
}
