      { "from": { "blockId": "auth-block",      "portId": "out" }, "to": { "blockId": "check-token",     "portId": "in" } },
      { "from": { "blockId": "check-token",     "portId": "true" }, "to": { "blockId": "caso01-crear",   "portId": "in" } },
      { "from": { "blockId": "check-token",     "portId": "true" }, "to": { "blockId": "caso02-infraccion","portId": "in" } },
      { "from": { "blockId": "check-token",     "portId": "true" }, "to": { "blockId": "caso03-listar",  "portId": "in" } },
      { "from": { "blockId": "check-token",     "portId": "true" }, "to": { "blockId": "caso04-listar",  "portId": "in" } },
      { "from": { "blockId": "caso01-crear",    "portId": "out" }, "to": { "blockId": "caso01-dup-ruc",  "portId": "in" } },
      { "from": { "blockId": "caso02-infraccion","portId": "out"}, "to": { "blockId": "caso02-cabecera", "portId": "in" } },
      { "from": { "blockId": "caso02-cabecera", "portId": "out" }, "to": { "blockId": "caso02-detalle",  "portId": "in" } },
      { "from": { "blockId": "caso03-listar",   "portId": "out" }, "to": { "blockId": "caso03-reconsidera","portId": "in" } },
      { "from": { "blockId": "caso04-listar",   "portId": "out" }, "to": { "blockId": "caso04-actualizar","portId": "in" } },
      { "from": { "blockId": "caso04-actualizar","portId": "out"}, "to": { "blockId": "caso04-confirmar","portId": "in" } },
      { "from": { "blockId": "caso01-dup-ruc",  "portId": "out" }, "to": { "blockId": "end",             "portId": "in" } },
      { "from": { "blockId": "caso02-detalle",  "portId": "out" }, "to": { "blockId": "end",             "portId": "in" } },
      { "from": { "blockId": "caso03-reconsidera","portId":"out"}, "to": { "blockId": "end",             "portId": "in" } },
      { "from": { "blockId": "caso04-confirmar","portId": "out" }, "to": { "blockId": "end",             "portId": "in" } }
