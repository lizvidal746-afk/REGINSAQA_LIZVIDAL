# Copia este archivo como .env.k6.local y completa valores reales.
# No subas tokens ni credenciales reales al repositorio.

# API base REGINSA
BASE_URL=https://reginsaapiqa.sunedu.gob.pe/api

# Token API (usa uno de estos dos; si defines ambos, cada script toma su prioridad interna)
REGINSA_API_AUTH_HEADER=Bearer REEMPLAZAR_TOKEN_API
REGINSA_API_TOKEN=Bearer REEMPLAZAR_TOKEN_API

# Login opcional para auto-token en scripts k6
REGINSA_USER=
REGINSA_PASS=
